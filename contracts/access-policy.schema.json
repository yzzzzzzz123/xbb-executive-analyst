{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xbb/contracts/access-policy.schema.json",
  "title": "销帮帮经营分析企业微信访问策略",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "users"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "users": {
      "type": "object",
      "maxProperties": 5000,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope"],
        "properties": {
          "scope": {
            "enum": ["all", "companies"]
          },
          "companies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    }
  }
}
